# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection (docker-compose db service + app's spring.datasource.*)
DB_USER=home_forge
DB_PASSWORD=changeme

# Schema HUB's own tables live in (hub.db.default-schema); plugins get their own schemas
DB_SCHEMA=hub_schema

# Hibernate ddl-auto strategy (spring.jpa.hibernate.ddl-auto): none, validate, update, create, create-drop
JPA_DDL_AUTO=update

# Remote plugin store to fetch plugin metadata/jars from (hub.plugin-store.url); leave blank to disable
# #TODO while server ser change to real value
PLUGIN_STORE_URL=

# Basic-auth password for the plugin store client (hub.plugin-store.password)
# TODO while server ser change to real value also think in feture to secure login. User can login, but not show real password public
SERWER_PASSWORD=changeme
